// ============================================================================
// Invoice SaaS — Prisma Schema
// Source of truth: Master Build Prompt (section 5) + JSON Product Specification
// PostgreSQL, UUID PKs, Decimal for money, explicit indexes & composite uniques.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FileCategory {
  BUSINESS_LOGO
  SELLER_STAMP
  SELLER_SIGNATURE
  CUSTOMER_STAMP
  CUSTOMER_SIGNATURE
  GENERATED_PDF
  GENERATED_IMAGE
  GENERATED_EXCEL
}

enum PlanKey {
  FREE
  BASIC
  PRO
}

enum BillingInterval {
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
  PAYMENT_FAILED
}

enum InvoiceType {
  PROFORMA
  FINAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum OAuthProvider {
  GOOGLE
}

enum CalendarType {
  JALALI
  GREGORIAN
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(uuid())
  googleId    String     @unique
  email       String     @unique
  name        String
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLoginAt DateTime?

  accounts         Account[]
  oauthConnections OAuthConnection[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  @@map("users")
}

model Account {
  id          String        @id @default(uuid())
  ownerUserId String
  owner       User          @relation(fields: [ownerUserId], references: [id])
  name        String
  status      AccountStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  businesses           Business[]
  subscriptions        Subscription[]
  usagePeriods         UsagePeriod[]
  files                File[]
  subscriptionPayments SubscriptionPayment[]
  auditLogs            AuditLog[]
  notifications        Notification[]

  // One Account per User. Enforced in application logic (bootstrap.ts finds
  // the existing Account before creating one), and backed here at the DB
  // level so a race condition or a future code path can never create a
  // second Account for the same owner (requirement: "returning login must
  // not create a new Account or Business").
  @@unique([ownerUserId])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// BUSINESS
// ---------------------------------------------------------------------------

model Business {
  id         String    @id @default(uuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  name       String
  isActive   Boolean   @default(true)
  isLocked   Boolean   @default(false)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  profile         BusinessProfile?
  invoiceSettings InvoiceSettings?
  customers       Customer[]
  products        Product[]
  invoices        Invoice[]
  files           File[]

  @@index([accountId])
  @@map("businesses")
}

model BusinessProfile {
  id                    String   @id @default(uuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id])
  businessName          String
  slogan                String?
  ownerName             String?
  address               String?
  email                 String?
  mobile                String?
  landline              String?
  cardNumber            String?
  accountNumber         String?
  iban                  String?
  logoFileId            String?
  sellerStampFileId     String?
  sellerSignatureFileId String?
  primaryColor          String?
  footerText            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("business_profiles")
}

model File {
  id           String       @id @default(uuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  businessId   String?
  business     Business?    @relation(fields: [businessId], references: [id])
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  category     FileCategory
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  @@index([accountId])
  @@index([businessId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// SUBSCRIPTION / PLANS
// ---------------------------------------------------------------------------

model Plan {
  id              String          @id @default(uuid())
  key             PlanKey         @unique
  name            String
  description     String
  price           Decimal         @db.Decimal(14, 2)
  currency        String          @default("IRR")
  billingInterval BillingInterval @default(MONTHLY)
  businessLimit   Int
  invoiceLimit    Int
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model Feature {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id            String  @id @default(uuid())
  planId        String
  plan          Plan    @relation(fields: [planId], references: [id])
  featureId     String
  feature       Feature @relation(fields: [featureId], references: [id])
  enabled       Boolean @default(true)
  configuration Json?

  @@unique([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  id        String             @id @default(uuid())
  accountId String
  account   Account            @relation(fields: [accountId], references: [id])
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  usagePeriods         UsagePeriod[]
  subscriptionPayments SubscriptionPayment[]

  @@index([accountId])
  @@index([status])
  @@map("subscriptions")
}

model UsagePeriod {
  id             String       @id @default(uuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  invoiceCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([accountId, periodStart, periodEnd])
  @@index([accountId])
  @@index([subscriptionId])
  @@map("usage_periods")
}

// ---------------------------------------------------------------------------
// CUSTOMERS / PRODUCTS
// ---------------------------------------------------------------------------

model Customer {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])
  name          String
  mobile        String?
  phone         String?
  email         String?
  address       String?
  nationalId    String?
  economicCode  String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  invoices Invoice[]

  @@index([businessId])
  @@map("customers")
}

model Product {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  name        String
  description String?
  price       Decimal   @db.Decimal(14, 2)
  unit        String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  invoiceItems InvoiceItem[]

  @@index([businessId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// INVOICES
// ---------------------------------------------------------------------------

model InvoiceSettings {
  id                 String       @id @default(uuid())
  businessId         String       @unique
  business           Business     @relation(fields: [businessId], references: [id])
  invoicePrefix      String?
  nextInvoiceNumber  Int          @default(1)
  defaultVatPercent  Decimal      @default(0) @db.Decimal(5, 2)
  currency           String       @default("IRR")
  calendar           CalendarType @default(JALALI)
  defaultTemplate    String       @default("default")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("invoice_settings")
}

model Invoice {
  id                    String        @id @default(uuid())
  businessId            String
  business              Business      @relation(fields: [businessId], references: [id])
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id])
  invoiceNumber         String
  invoiceType           InvoiceType
  issueDate             DateTime
  dueDate               DateTime?
  status                InvoiceStatus @default(DRAFT)

  subtotal              Decimal @default(0) @db.Decimal(14, 2)
  itemDiscountAmount    Decimal @default(0) @db.Decimal(14, 2)
  globalDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  globalDiscountAmount  Decimal @default(0) @db.Decimal(14, 2)
  taxPercent            Decimal @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount         Decimal @default(0) @db.Decimal(14, 2)
  total                 Decimal @default(0) @db.Decimal(14, 2)
  paidAmount            Decimal @default(0) @db.Decimal(14, 2)
  remainingAmount       Decimal @default(0) @db.Decimal(14, 2)

  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?
  cancelledAt DateTime?

  items            InvoiceItem[]
  payments         InvoicePayment[]
  sellerSnapshot   InvoiceSellerSnapshot?
  customerSnapshot InvoiceCustomerSnapshot?

  // Invoice numbers are unique per business, but only meaningfully assigned
  // once finalized. Drafts may share a placeholder; enforce at app layer for
  // drafts and via this constraint for the numbering itself.
  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  title           String
  description     String?
  itemDate        DateTime?
  unitPrice       Decimal  @db.Decimal(14, 2)
  quantity        Decimal  @db.Decimal(12, 3)
  unit            String?
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(14, 2)
  subtotal        Decimal  @default(0) @db.Decimal(14, 2)
  total           Decimal  @default(0) @db.Decimal(14, 2)
  sortOrder       Int      @default(0)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model InvoicePayment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now())
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@map("invoice_payments")
}

// Immutable snapshots taken at finalization time (section 6 / 44 of build prompt).
model InvoiceSellerSnapshot {
  id                    String  @id @default(uuid())
  invoiceId             String  @unique
  invoice               Invoice @relation(fields: [invoiceId], references: [id])
  businessName          String
  slogan                String?
  ownerName             String?
  address               String?
  email                 String?
  mobile                String?
  landline              String?
  cardNumber            String?
  accountNumber         String?
  iban                  String?
  logoFileId            String?
  sellerStampFileId     String?
  sellerSignatureFileId String?
  primaryColor          String?
  footerText            String?

  @@map("invoice_seller_snapshots")
}

model InvoiceCustomerSnapshot {
  id           String  @id @default(uuid())
  invoiceId    String  @unique
  invoice      Invoice @relation(fields: [invoiceId], references: [id])
  name         String
  mobile       String?
  phone        String?
  email        String?
  address      String?
  nationalId   String?
  economicCode String?

  @@map("invoice_customer_snapshots")
}

// ---------------------------------------------------------------------------
// BILLING / PAYMENTS (SaaS subscription, distinct from invoice payments)
// ---------------------------------------------------------------------------

model SubscriptionPayment {
  id             String                    @id @default(uuid())
  accountId      String
  account        Account                   @relation(fields: [accountId], references: [id])
  subscriptionId String
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id])
  provider       String
  amount         Decimal                   @db.Decimal(14, 2)
  currency       String                    @default("IRR")
  status         SubscriptionPaymentStatus @default(PENDING)
  authority      String?
  transactionId  String?
  referenceId    String?
  createdAt      DateTime                  @default(now())
  verifiedAt     DateTime?

  @@index([accountId])
  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_payments")
}

// ---------------------------------------------------------------------------
// OAUTH / AUDIT / NOTIFICATIONS
// ---------------------------------------------------------------------------

model OAuthConnection {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  provider              OAuthProvider
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scope                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_connections")
}

model AuditLog {
  id         String   @id @default(uuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
  @@index([userId])
  @@map("notifications")
}
