# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/invoice_saas?schema=public"

# ---------------------------------------------------------------------------
# NextAuth / Google OAuth
# You must create an OAuth 2.0 Client ID in Google Cloud Console with an
# Authorized redirect URI of: {APP_URL}/api/auth/callback/google
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Separate, additive Gmail-send scope requested only when the user opts in
# to email sending (see src/lib docs — Google login != Gmail permission).
GMAIL_SEND_SCOPE="https://www.googleapis.com/auth/gmail.send"

# Optional override for the Gmail connect redirect URI. Defaults to
# {APP_URL}/api/gmail/callback — whatever is used MUST be registered as an
# Authorized redirect URI in the same Google Cloud OAuth client above,
# otherwise the Gmail connect flow fails at Google with redirect_uri_mismatch.
GMAIL_REDIRECT_URI=""

# Symmetric key used to encrypt OAuth access/refresh tokens at rest.
# Generate with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Object storage — REAL S3-compatible adapter (AWS S3, Cloudflare R2, MinIO,
# Arvan, Liara, ...). Server-side only: credentials never reach the browser.
#
# Required for uploads (business logo / seller stamp / seller signature):
#   STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY, STORAGE_BUCKET
# Optional:
#   STORAGE_ENDPOINT  — custom endpoint for R2/MinIO/... providers (path-style
#                       addressing is used automatically); leave empty for AWS.
#   STORAGE_REGION    — default "us-east-1" when empty.
#   STORAGE_PUBLIC_BASE_URL — public base URL of the bucket; used ONLY to
#                       build display URLs in the UI. When empty, uploads
#                       still work but images are not rendered from a CDN.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="invoice-saas-files"
STORAGE_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Payment gateway — provider abstraction in src/server/payments/
#
#   PaymentProvider.ts  the swappable interface (createPayment, verifyPayment,
#                       getPaymentStatus, refundPayment)
#   factory.ts          resolves these variables into a provider instance and
#                       enforces the production-safety rules below
#
# PAYMENT_PROVIDER      "zarinpal" (default) or "sandbox". An unrecognized
#                       value is an ERROR, never a silent fallback — a typo
#                       here would otherwise change which gateway takes money.
# PAYMENT_MERCHANT_ID   Provider merchant code. For ZarinPal this is the
#                       36-character UUID from the merchant panel; anything
#                       else is rejected (catches a pasted API key).
# PAYMENT_CALLBACK_URL  Absolute URL the payer returns to after paying. Also
#                       used as an ORIGIN ALLOWLIST: a checkout request whose
#                       callback URL is on another origin is refused.
# PAYMENT_SANDBOX       "true" / "false". Unset means sandbox outside
#                       production and live inside production.
#
# Production safety (enforced by src/server/payments/factory.ts):
#   - Sandbox cannot be enabled while NODE_ENV=production. A deployment that
#     lost its `PAYMENT_SANDBOX=false` must fail loudly, not report payments
#     as successful that no gateway ever saw.
#   - Live mode requires PAYMENT_MERCHANT_ID and an https
#     PAYMENT_CALLBACK_URL; payer return data never travels in clear text.
#   - The "sandbox" provider (an in-memory simulator, no network) cannot be
#     selected in production at all.
#
# No variable here is exposed to the client; there is no NEXT_PUBLIC_
# counterpart, and the factory lives under src/server/.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="zarinpal"
PAYMENT_MERCHANT_ID=""
PAYMENT_CALLBACK_URL="http://localhost:3000/api/payments/callback"
PAYMENT_SANDBOX="true"

# ---------------------------------------------------------------------------
# Plan pricing (read by prisma/seed.ts — never hard-code prices in UI code)
# Amounts in IRR (Iranian Rial), integer, no formatting.
# ---------------------------------------------------------------------------
PLAN_PRICE_FREE="0"
PLAN_PRICE_BASIC="0"
PLAN_PRICE_PRO="0"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"
